# PersEventos — variáveis de ambiente (copie para .env.local e preencha).
# Nunca versione o .env.local (ele é ignorado pelo git).

# Supabase (obrigatórias)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
SUPABASE_SECRET_KEY=sua-service-role-key

# Segredo compartilhado do webhook de pagamento (Fase 2).
# O provedor de pagamento deve enviar o header `x-webhook-secret` com este valor.
# Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# Base URL pública usada nos QR Codes de check-in (opcional em produção)
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com
