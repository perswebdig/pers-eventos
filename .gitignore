# env files (can opt-in for committing if needed)
.env*
!.env.example

# PWA (gerados pelo @ducanh2912/next-pwa no build)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
/public/fallback-*.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
